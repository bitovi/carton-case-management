# Database (local SQLite file)
#
# IMPORTANT: Prisma resolves relative `file:` paths against the directory containing the schema
# (packages/shared/prisma/), NOT the project root and NOT the current working directory.
# This value therefore points at packages/server/db/dev.db, and is correct in every environment
# (host, devcontainer, Docker, CI) regardless of the absolute path of the repo.
#
# Docker and the devcontainer set this themselves, so this file only matters when you run the
# app directly with npm. `npm run setup` creates it for you.
DATABASE_URL="file:../../server/db/dev.db"

# Log in as a specific seeded user. If unset, defaults to the first user in the database.
# MOCK_USER_EMAIL=taylor.smith@carton.com
