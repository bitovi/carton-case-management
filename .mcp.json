{
	"mcpServers": {
		"microsoft/playwright-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			]
		},
		"Database": {
			"command": "sh",
			"args": [
				"-c",
				"npx -y @bytebase/dbhub --transport stdio --dsn sqlite://$(git rev-parse --show-toplevel)/packages/shared/prisma/prisma/dev.db"
			]
		}
	},
	"inputs": []
}