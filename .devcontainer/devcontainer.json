{
  "name": "Carton Case Management",
  "dockerComposeFile": "../docker-compose.dev.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/carton-case-management",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  // Playwright's browser download (~511MB extracted) happens here, once at container creation,
  // rather than ambushing the first `npm run test:e2e`. The full browser is installed, not just
  // the headless shell, because test:e2e:watch (`--ui`) and the report on port 9323 need it.
  // Chromium's OS libraries come from .devcontainer/Dockerfile, so `--with-deps` is not needed.
  "postCreateCommand": "npm install && npm run setup && npx playwright install chromium",
  "postStartCommand": "npm run dev",
  "forwardPorts": [5173, 3001, 6006, 9323],
  "portsAttributes": {
    "5173": {
      "label": "Client",
      "onAutoForward": "openPreview"
    },
    "3001": {
      "label": "Server",
      "onAutoForward": "ignore"
    },
    "6006": {
      "label": "Storybook",
      "onAutoForward": "ignore"
    },
    "9323": {
      "label": "Playwright Report",
      "onAutoForward": "openPreview"
    }
  },
  "containerEnv": {
    "NODE_ENV": "development",
    "DATABASE_URL": "file:../../server/db/dev.db"
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "Prisma.prisma"]
    }
  }
}
