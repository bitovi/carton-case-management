{
	"servers": {
		"Atlassian": {
			"type": "http",
			"url": "https://mcp.atlassian.com/v1/mcp"
		},
		"Database": {
			"command": "npx",
			"args": [
				"-y",
				"@bytebase/dbhub",
				"--transport",
				"stdio",
				"--dsn",
				"sqlite:///workspaces/carton-case-management/packages/shared/prisma/prisma/dev.db"
			]
		},
		// "Database-Postgres": {
