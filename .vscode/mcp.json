		// 		"@bytebase/dbhub",
		// 		"--transport",
		// 		"stdio",
		// 		"--dsn",
		// 		"postgresql://${input:dbUser}:${input:dbPassword}@hostname:5432/dbname"
		// 	]
		// }
	},
	"inputs": [
		{ "id": "dbUser", "type": "promptString", "description": "DB username" },
		{ "id": "dbPassword", "type": "promptString", "description": "DB password", "password": true }
	]
}