FROM node:24-bookworm-slim

# Install system dependencies required for Playwright
RUN apt-get update && apt-get install -y \
    curl \
    # Playwright dependencies for Chromium
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY packages/server/package*.json ./packages/server/
COPY packages/client/package*.json ./packages/client/
# The root postinstall hook runs these two, so they have to exist before `npm ci`.
COPY .env.example ./
COPY scripts/ ./scripts/

# Install all dependencies (including dev)
RUN npm ci

# Install Playwright's headless Chromium. `--only-shell` skips the full headed browser (~324MB
# extracted), which this image never uses: playwright.config.ts declares one headless chromium
# project. The OS libraries Chromium needs are installed by apt above, so `--with-deps` is not
# wanted here - it would re-run `apt-get update` on every build.
# The tests service runs `test:e2e:ci`, which skips the install step because of this layer.
RUN npx playwright install --only-shell chromium

# Copy source code
COPY . .

# Generate Prisma Client and the Zod schemas before building. Neither is committed, and `npm ci`
# does not run @prisma/client's postinstall, so without this step tRPC type inference degrades and
# the client build fails with implicit-any errors.
# Relative to the Prisma schema dir (packages/shared/prisma/) -> packages/server/db/dev.db
ENV DATABASE_URL=file:../../server/db/dev.db
RUN npm run db:generate

# Build all packages
RUN npm run build

ENV NODE_ENV=test
EXPOSE 5173 3001
