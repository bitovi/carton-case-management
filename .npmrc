# Install optional dependencies, so a lockfile made on Apple Silicon still resolves on x64.
# This is npm's default; it is spelled out here because the old `optional=true` spelling is
# deprecated and made npm print a four-line config warning before every single script.
include=optional

# Use a lockfile version that's compatible with both ARM64 and x64
# This prevents lockfile conflicts between Apple Silicon and Intel Macs
lockfile-version=3

# Only install packages that have been published for at least 7 days (supply-chain policy)
min-release-age=7
